# Backend process / Docker Compose settings (replace before hosting).
JWT_SECRET=replace-with-a-private-random-value-of-at-least-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-private-admin-password
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEMO_ENABLED=false

# Optional hosted database, supplied as a JDBC URL.
# DB_URL=jdbc:mysql://your-host:3306/smart_parking
# DB_USERNAME=your_database_user
# DB_PASSWORD=your_private_database_password

# Frontend build setting. Use /api for the local Vite/Docker proxy,
# or the Railway backend HTTPS URL plus /api for separate hosting.
VITE_API_BASE_URL=/api
VITE_DEMO_ENABLED=false
